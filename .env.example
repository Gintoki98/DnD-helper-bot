# --- Telegram -------------------------------------------------------------
# From https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# Bot token from @BotFather. The bot signs in with this; no phone number
# prompt and no interactive login.
BOT_TOKEN=

# Your own numeric user id (ask @userinfobot) to be recognised as an admin
ADMIN_ID=

# --- SRD API --------------------------------------------------------------
# SRD 5.2.1 (2014). Leave as-is unless you run a mirror.
SRD_API_BASE=https://www.dnd5eapi.co
SRD_API_VERSION=2014
# Seconds a fetched SRD entry stays cached on disk (default: one week)
SRD_CACHE_TTL=604800

# --- Bot behaviour --------------------------------------------------------
DEFAULT_SYSTEM=5e
# Seconds before a pending join request auto-expires
REQUEST_TTL=86400

# --- Logging --------------------------------------------------------------
# Where bot.log and errors.log are written
LOG_LEVEL=INFO
# Rotate bot.log at 5 MB, keeping LOG_BACKUPS previous files
LOG_MAX_BYTES=5242880
LOG_BACKUPS=3
